# Meta tracker — environment variables (Railway → service → Variables, or local .env)

# Meta
META_PIXEL_ID=1298114545063437            # Core Club dataset
META_ACCESS_TOKEN=                        # Events Manager → Core Club → Settings → Conversions API → Generate access token
META_TEST_EVENT_CODE=                     # Events Manager → Test events code. Set during testing, delete to go live.

# Backup datasets (optional): each gets a copy of every event, and every order
# placed after it was added. Each needs its own Conversions API token from that
# dataset's Settings. Add _3, _4 ... the same way.
# META_PIXEL_ID_2=1717074239276698        # "eczema" backup pixel (QC business)
# META_ACCESS_TOKEN_2=
# META_TEST_EVENT_CODE_2=                 # only to test this pixel on its own
# What the hub calls each pixel. Default: Meta's dataset name, else Core Club / Eczema by id.
# META_PIXEL_NAME=Core Club
# META_PIXEL_NAME_2=Eczema

# Shopify (same values as the Shopify MCP service)
SHOPIFY_STORE=n3zxxv-01
SHOPIFY_ACCESS_TOKEN=                     # shpat_... needs read_orders  (or use the two below)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=                   # optional: app API secret key, enables instant webhooks
STORE_URL=https://getcoresupps.com

# Server
PUBLIC_URL=                               # the Railway URL, e.g. https://xxx.up.railway.app
ADMIN_TOKEN=                              # long random string; protects /report and /mcp
DATA_DIR=/data                            # the Railway volume mount path
# ALLOW_EPHEMERAL_DATA=true               # local development only

# Hub (dashboard at /hub, log in with ADMIN_TOKEN)
# META_ADS_TOKEN=                         # Marketing API token with ads_read (e.g. the P&L's META_ACCESS_TOKEN)
# META_AD_ACCOUNT_IDS=1537379363921450    # comma-separated ad accounts to read spend and per-ad sales from
# STORE_TIMEZONE=America/New_York         # days in the hub follow the store's clock
# ATTRIBUTION_WINDOW_DAYS=7               # a sale is credited to the last Meta ad clicked within this window
# PURCHASE_GRACE_SECONDS=300              # longest a sale with no browser and no Shopify visit record waits
# MATCH_RETRY_SECONDS=60,120              # when it looks for them again before that (seconds after the order)
# JOURNEY_TIMEOUT_SECONDS=6               # longest one read of Shopify's visit history may take
# WATCHDOG_INTERVAL_SECONDS=300           # how often the watchdog re-checks everything
# HUB_MIN_AD_SPEND=15                     # creatives: an ad gets its own row from this much spend in the range
# PNL_URL=https://pnl-server-production.up.railway.app   # the P&L app the top section reads
# PNL_API_KEY=                            # only once the P&L asks for one; sent as a Bearer token

# Optional
# ALERT_WEBHOOK_URL=                      # Slack / Discord incoming webhook
# TRACK_ORDERS_FROM=2026-10-01T00:00:00Z  # deliberate backfill start (authoritative when set)
# RENEWAL_EVENT_NAME=SubscriptionRenewal  # "" to not send renewals at all
# Subscription rebills go to Meta as RENEWAL_EVENT_NAME, never as Purchase. An order
# is a rebill when its Shopify source is one of RENEWAL_SOURCE_NAMES, or when it
# carries one of RENEWAL_TAGS (comma-separated; the whole tag must match, any case).
# Kaching tags the first order of a subscription "Kaching Subscription First Order":
# that one is a real new sale and stays a Purchase. Set RENEWAL_TAGS empty to ignore tags.
# RENEWAL_SOURCE_NAMES=subscription_contract,subscription_contract_checkout_one
# RENEWAL_TAGS=Kaching Subscription Recurring Order
# SKIP_SOURCE_NAMES=shopify_draft_order,pos,iphone,android
# CONTENT_ID_FIELD=product_id             # product_id | variant_id | sku (match your Meta catalog)
# PURCHASE_VALUE_FIELD=total_price        # or subtotal_price
# TRUSTED_PROXY_HOPS=1                    # 2 if Cloudflare is put in front of Railway
